<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contador Premium</title>
    <style>
        /* Reset e Configurações Globais */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', system-ui, -apple-system, sans-serif;
        }

        /* Fundo dinâmico e centralização */
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background: linear-gradient(45deg, #0f172a, #1e1b4b, #311042);
            background-size: 300% 300%;
            animation: colorshift 15s ease infinite;
            overflow: hidden;
        }

        @keyframes colorshift {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Container Principal - Efeito Vidro (Glassmorphism) */
        .counter-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 40px 30px;
            border-radius: 24px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
            width: 350px;
            text-align: center;
            position: relative;
        }

        /* Brilho sutil no topo do card */
        .counter-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border-radius: 24px;
            background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 100%);
            pointer-events: none;
        }

        /* Título */
        h1 {
            font-size: 1.1rem;
            color: rgba(255, 255, 255, 0.6);
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 10px;
            font-weight: 500;
        }

        /* Display do Número Centralizado */
        .display-container {
            height: 140px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 20px;
        }

        .number-display {
            font-size: 6rem;
            font-weight: 700;
            color: #ffffff;
            transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
            text-shadow: 0 0 20px rgba(255, 255, 255, 0.1);
        }

        /* Layout dos Botões (+ e - na mesma linha) */
        .controls-row {
            display: flex;
            gap: 15px;
            margin-bottom: 15px;
        }

        /* Base dos Botões de Ação rápida (+ e -) */
        .btn-action {
            flex: 1;
            height: 65px;
            border: none;
            border-radius: 16px;
            font-size: 2rem;
            font-weight: 400;
            color: white;
            cursor: pointer;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: all 0.25s ease;
        }

        /* Botão de Menos - Gradiente Vermelho/Rosa */
        .btn-minus {
            background: linear-gradient(135deg, #ef4444, #b91c1c);
            box-shadow: 0 4px 15px rgba(239, 68, 68, 0.3);
        }

        /* Botão de Mais - Gradiente Verde/Ciano */
        .btn-plus {
            background: linear-gradient(135deg, #10b981, #047857);
            box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
        }

        /* Botão de Reset - Elegante e discreto abaixo */
        .btn-reset {
            width: 100%;
            height: 50px;
            border: 1px solid rgba(255, 255, 255, 0.15);
            background: rgba(255, 255, 255, 0.08);
            border-radius: 14px;
            color: rgba(255, 255, 255, 0.8);
            font-size: 0.95rem;
            font-weight: 500;
            letter-spacing: 1px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        /* Micro-interações (Efeitos ao passar o mouse e clicar) */
        .btn-action:hover {
            transform: translateY(-3px) scale(1.02);
            filter: brightness(1.15);
        }

        .btn-action:active {
            transform: translateY(1px) scale(0.98);
        }

        .btn-reset:hover {
            background: rgba(255, 255, 255, 0.2);
            color: #ffffff;
            border-color: rgba(255, 255, 255, 0.3);
        }

        .btn-reset:active {
            transform: scale(0.99);
        }

        /* Efeito de pulso para quando o número mudar */
        .pulse {
            transform: scale(1.15);
        }
    </style>
</head>
<body>

    <div class="counter-card">
        <h1>Contador</h1>
        
        <!-- O Número Centralizado -->
        <div class="display-container">
            <div class="number-display" id="counter">0</div>
        </div>

        <!-- Estrutura de botões controlada e harmônica -->
        <div class="controls-row">
            <button class="btn-action btn-minus" id="minus" aria-label="Diminuir">−</button>
            <button class="btn-action btn-plus" id="plus" aria-label="Aumentar">+</button>
        </div>
        
        <button class="btn-reset" id="reset">RESETAR</button>
    </div>

    <script>
        const counterDisplay = document.getElementById('counter');
        const btnMinus = document.getElementById('minus');
        const btnPlus = document.getElementById('plus');
        const btnReset = document.getElementById('reset');

        let count = 0;

        // Função responsável por atualizar o valor e aplicar os efeitos visuais de transição
        function updateCounter(newValue) {
            count = newValue;
            counterDisplay.textContent = count;
            
            // Adiciona efeito de pulso rápido na mudança do número
            counterDisplay.classList.add('pulse');
            setTimeout(() => counterDisplay.classList.remove('pulse'), 150);

            // Mudança sutil de sombra/brilho baseada no valor
            if (count > 0) {
                counterDisplay.style.textShadow = '0 0 25px rgba(16, 185, 129, 0.6)';
                counterDisplay.style.color = '#10b981';
            } else if (count < 0) {
                counterDisplay.style.textShadow = '0 0 25px rgba(239, 68, 68, 0.6)';
                counterDisplay.style.color = '#ef4444';
            } else {
                counterDisplay.style.textShadow = '0 0 20px rgba(255, 255, 255, 0.2)';
                counterDisplay.style.color = '#ffffff';
            }
        }

        // Ouvintes de eventos
        btnMinus.addEventListener('click', () => updateCounter(count - 1));
        btnPlus.addEventListener('click', () => updateCounter(count + 1));
        btnReset.addEventListener('click', () => updateCounter(0));
    </script>

</body>
</html>
